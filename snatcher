-- ==========================================
-- BUTTON EVENTS
-- ==========================================

local lastGeneratedCode = nil

closeBtn.MouseButton1Click:Connect(function()
	screenGui:Destroy()
end)

generateBtn.MouseButton1Click:Connect(function()
	local target = resolvePath(pathBox.Text)
	if not target then
		statusLabel.Text = "Error: Could not find path '" .. pathBox.Text .. "'"
		statusLabel.TextColor3 = Color3.fromRGB(240, 90, 90)
		return
	end

	local code, count = generateRecreationScript(target)
	lastGeneratedCode = code

	if setclipboard then
		setclipboard(code)
		statusLabel.Text = string.format("Copied script for %d objects from '%s'!", count, target.Name)
		statusLabel.TextColor3 = Color3.fromRGB(90, 230, 130)
	else
		statusLabel.Text = "Generated " .. count .. " objects, but setclipboard is unsupported."
		statusLabel.TextColor3 = Color3.fromRGB(240, 200, 80)
	end
end)

testRunBtn.MouseButton1Click:Connect(function()
	if not lastGeneratedCode then
		statusLabel.Text = "Generate a script first before testing!"
		statusLabel.TextColor3 = Color3.fromRGB(240, 200, 80)
		return
	end

	if loadstring then
		local fn, err = loadstring(lastGeneratedCode)
		if fn then
			fn()
			statusLabel.Text = "Successfully ran generated script!"
			statusLabel.TextColor3 = Color3.fromRGB(90, 230, 130)
		else
			statusLabel.Text = "Syntax error: " + tostring(err)
			statusLabel.TextColor3 = Color3.fromRGB(240, 90, 90)
		end
	else
		statusLabel.Text = "loadstring is not enabled in this environment."
		statusLabel.TextColor3 = Color3.fromRGB(240, 90, 90)
	end
end)
