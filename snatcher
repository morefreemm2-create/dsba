-- ==========================================
-- SERIALIZATION ENGINE
-- ==========================================

local function serializeValue(val)
	local t = typeof(val)
	if t == "number" or t == "boolean" then
		return tostring(val)
	elseif t == "string" then
		return string.format("%q", val)
	elseif t == "EnumItem" then
		return tostring(val)
	elseif t == "Vector2" then
		return string.format("Vector2.new(%f, %f)", val.X, val.Y)
	elseif t == "Vector3" then
		return string.format("Vector3.new(%f, %f, %f)", val.X, val.Y, val.Z)
	elseif t == "CFrame" then
		return string.format("CFrame.new(%s)", tostring(val))
	elseif t == "Color3" then
		return string.format("Color3.new(%f, %f, %f)", val.R, val.G, val.B)
	elseif t == "UDim" then
		return string.format("UDim.new(%f, %f)", val.Scale, val.Offset)
	elseif t == "UDim2" then
		return string.format("UDim2.new(%f, %f, %f, %f)", val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
	elseif t == "NumberRange" then
		return string.format("NumberRange.new(%f, %f)", val.Min, val.Max)
	elseif t == "NumberSequence" then
		local kps = {}
		for _, kp in ipairs(val.Keypoints) do
			table.insert(kps, string.format("NumberSequenceKeypoint.new(%f, %f, %f)", kp.Time, kp.Value, kp.Envelope))
		end
		return string.format("NumberSequence.new({%s})", table.concat(kps, ", "))
	elseif t == "ColorSequence" then
		local kps = {}
		for _, kp in ipairs(val.Keypoints) do
			table.insert(kps, string.format("ColorSequenceKeypoint.new(%f, Color3.new(%f, %f, %f))", kp.Time, kp.Value.R, kp.Value.G, kp.Value.B))
		end
		return string.format("ColorSequence.new({%s})", table.concat(kps, ", "))
	else
		return nil -- Unsupported property type
	end
end

-- Comprehensive properties list including Parts, Effects, Animations, and GUIs
local commonProperties = {
	-- General & Parts
	"Name", "Anchored", "CanCollide", "Transparency", "Color", "Material", "Size", "CFrame",
	"Position", "Orientation", "Texture", "TextureID", "Scale", "AnimationId",
	-- Particle Emitters & Beams & Lights
	"Acceleration", "Brightness", "Drag", "EmissionDirection", "Enabled",
	"FlipbookFramerate", "FlipbookLayout", "FlipbookMode", "FlipbookStartRandom",
	"Lifetime", "LightEmission", "LightInfluence", "LockedToPart", "Rate",
	"Rotation", "RotSpeed", "Shape", "ShapeInOut", "ShapeStyle", "Speed",
	"SpreadAngle", "TimeScale", "ZOffset", "Range", "Shadows", "Face",
	"Width0", "Width1", "Segments", "CurveSize0", "CurveSize1", "TextureSpeed", "TextureLength",
	-- GUI Properties
	"BackgroundColor3", "BackgroundTransparency", "BorderColor3", "BorderSizePixel",
	"FontFace", "Text", "TextColor3", "TextSize", "TextTransparency", "TextWrapped",
	"TextXAlignment", "TextYAlignment", "PlaceholderText", "PlaceholderColor3", "Draggable", "Visible", "ZIndex", "Image", "ImageColor3", "ImageTransparency",
	"ScaleType", "CornerRadius"
}

local function resolvePath(pathString)
	local segments = string.split(pathString, ".")
	local current = game
	for i, seg in ipairs(segments) do
		if i == 1 and seg:lower() == "game" then
			continue
		elseif i == 1 and seg:lower() == "workspace" then
			current = workspace
		else
			current = current:FindFirstChild(seg)
			if not current then return nil end
		end
	end
	return current
end

local function generateRecreationScript(rootFolder)
	local lines = {
		"-- Auto-Generated Folder/GUI Recreation Script",
		"local rootFolder = Instance.new(\"Folder\")",
		string.format("rootFolder.Name = %q", rootFolder.Name),
		""
	}

	local counter = 0
	local function parseChildren(parentObj, parentVarName)
		for _, child in ipairs(parentObj:GetChildren()) do
			local ok, inst = pcall(function() return Instance.new(child.ClassName) end)
			if ok and inst then
				inst:Destroy() 
				counter += 1
				local varName = "obj_" .. counter
				table.insert(lines, string.format("local %s = Instance.new(%q)", varName, child.ClassName))
				
				for _, prop in ipairs(commonProperties) do
					local success, val = pcall(function() return child[prop] end)
					if success and val ~= nil then
						local serialized = serializeValue(val)
						if serialized then
							table.insert(lines, string.format("%s.%s = %s", varName, prop, serialized))
						end
					end
				end
				
				table.insert(lines, string.format("%s.Parent = %s\n", varName, parentVarName))
				parseChildren(child, varName)
			end
		end
	end

	parseChildren(rootFolder, "rootFolder")
	table.insert(lines, "rootFolder.Parent = workspace")
	table.insert(lines, string.format("print(\"Recreated %d instances inside \" .. rootFolder.Name)", counter))
	
	return table.concat(lines, "\n"), counter
end

